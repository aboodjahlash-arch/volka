{
  "name": "volk-ai",
  "version": "1.0.0",
  "private": true,
  "description": "VOLK AI — AI agent platform for cybersecurity and ethical hacking combining VS Code integration, Gemini 2.5 Flash, and autonomous agent capabilities",
  "workspaces": [
    "ext",
    "agent-core",
    "shared",
    "sandbox"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=sandbox && npm run build --workspace=agent-core && npm run build --workspace=ext",
    "clean": "npm run clean --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
